# Gemini는 선택 사항입니다. 키 없이 공식 수집·로컬 추출·규칙 퀴즈를 사용할 수 있습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 표준국어대사전 개발 지원에서 발급받은 키. 없으면 사전 원문 링크를 안내합니다.
STDICT_API_KEY=
CULTUREBRIDGE_GEMINI_TIMEOUT_MS=15000
CULTUREBRIDGE_QUIZ_TIMEOUT_MS=30000
CULTUREBRIDGE_GEMINI_ENABLED=true
CULTUREBRIDGE_DB_PATH=data/culturebridge.db
CULTUREBRIDGE_HOST=127.0.0.1
CULTUREBRIDGE_PORT=8080
CULTUREBRIDGE_STORAGE_SECRET=change-this-in-local-env
# 외부 공개 시 true와 32자 이상 별도 STORAGE_SECRET을 설정하세요.
CULTUREBRIDGE_PUBLIC_MODE=false
# HTTPS로 공개 운영할 때 true. 로컬 HTTP에서는 false를 유지합니다.
CULTUREBRIDGE_SECURE_COOKIES=false
CULTUREBRIDGE_MAX_LEARNING_JOBS=3
CULTUREBRIDGE_LEARNING_REUSE_SECONDS=300
CULTUREBRIDGE_REQUESTS_PER_MINUTE=30
CULTUREBRIDGE_INDIVIDUAL_SOURCES_ENABLED=true
# 검사에 실패한 AI 퀴즈의 제한된 부분 수정: 0 또는 1회 (429/연결 실패는 재시도하지 않음)
CULTUREBRIDGE_QUIZ_REPAIR_ATTEMPTS=1
# 운영 자동화는 기본 비활성. 활성화하면 시작 시와 이후 지정 간격에 백업합니다.
CULTUREBRIDGE_MAINTENANCE_ENABLED=false
CULTUREBRIDGE_MAINTENANCE_INTERVAL_HOURS=24
CULTUREBRIDGE_BACKUP_DIR=backups
CULTUREBRIDGE_BACKUP_KEEP=14
# 자동 기록 삭제는 별도로 켜야 적용됩니다. 삭제 전 검증된 백업을 생성합니다.
CULTUREBRIDGE_RETENTION_ENABLED=false
CULTUREBRIDGE_RECORD_RETENTION_DAYS=90
