# Gemini는 선택 사항입니다. 키 없이 공식 수집·로컬 추출·규칙 퀴즈를 사용할 수 있습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CULTUREBRIDGE_GEMINI_TIMEOUT_MS=15000
CULTUREBRIDGE_QUIZ_TIMEOUT_MS=30000
CULTUREBRIDGE_GEMINI_ENABLED=true
CULTUREBRIDGE_DB_PATH=data/culturebridge.db
CULTUREBRIDGE_HOST=127.0.0.1
CULTUREBRIDGE_PORT=8080
CULTUREBRIDGE_STORAGE_SECRET=change-this-in-local-env
# 외부 공개 시 true와 32자 이상 별도 STORAGE_SECRET을 설정하세요.
CULTUREBRIDGE_PUBLIC_MODE=false
CULTUREBRIDGE_MAX_LEARNING_JOBS=3
CULTUREBRIDGE_LEARNING_REUSE_SECONDS=300
CULTUREBRIDGE_REQUESTS_PER_MINUTE=30
CULTUREBRIDGE_INDIVIDUAL_SOURCES_ENABLED=true
